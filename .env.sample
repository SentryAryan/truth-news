#Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

#Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API (server only)
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# Admin secret for pipeline action routes (server only; header x-biasly-admin-secret)
BIASLY_ADMIN_SECRET=

# OpenRouter (server only) — analysis model is always openrouter/free
OPENROUTER_API_KEY=

# Optional: embedding model id via OpenRouter (default nvidia/nemotron-3-embed-1b:free, 2048-d)
# Do not use openrouter/free here — that id is chat-only.
EMBEDDING_MODEL_ID=nvidia/nemotron-3-embed-1b:free

# Optional: articles analyzed per batch (default 5)
ANALYSIS_BATCH_SIZE=5

# Optional: max pending articles per POST /api/analyze run (default 20)
ANALYSIS_MAX_PER_RUN=20

# CRON_SECRET is injected by Vercel for GET /api/cron/pipeline.
# Do not set it in .env.local. Local `next dev` skips the check.

# Optional. Unset or on: daily Oxylabs schedules (06:00 UTC) and the Vercel cron pipeline run.
# off: deactivate Oxylabs schedules and skip cron scraping and analysis.
# SCHEDULED_PIPELINE_ENABLED=on

# PostHog query API for the homepage Trending rail (server only).
# Create a personal API key with query read access. POSTHOG_PROJECT_ID is the numeric project id.
# Queries go to https://us.posthog.com, not the ingestion host (NEXT_PUBLIC_POSTHOG_HOST).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
