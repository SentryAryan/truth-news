#Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

#Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API (server only)
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# Admin secret for pipeline action routes (server only; header x-biasly-admin-secret)
BIASLY_ADMIN_SECRET=

# OpenRouter (server only) — analysis model is always openrouter/free
OPENROUTER_API_KEY=

# Optional: articles analyzed per batch (default 5)
ANALYSIS_BATCH_SIZE=5

# Optional: max pending articles per POST /api/analyze run (default 20)
ANALYSIS_MAX_PER_RUN=20